# Backend settings
APP_NAME=LogPulse API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api/v1

# Allow comma-separated values for CORS_ORIGINS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local backend connection defaults
DATABASE_URL=postgresql+psycopg://logpulse:logpulse@localhost:5432/logpulse
ENABLE_KAFKA=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_LOGS_RAW=logs.raw
KAFKA_CONSUMER_GROUP=logpulse-stream-local
KAFKA_POLL_TIMEOUT_MS=1000
LOG_BUFFER_SIZE=500
ANOMALY_SCORING_ENABLED=true
ANOMALY_MODEL_WARMUP_EVENTS=200
ANOMALY_MODEL_RETRAIN_INTERVAL=100
ANOMALY_MODEL_CONTAMINATION=0.08
RULE_LATENCY_THRESHOLD_MS=800
RULE_SOURCE_BURST_WINDOW=120
RULE_SOURCE_BURST_THRESHOLD=20
BATCH_INTERVAL_SECONDS=900
BATCH_WINDOW_EVENTS=1200
BATCH_USE_PYSPARK=true
BATCH_RUN_LOOP=false

# Agent runtime defaults (LangChain RCA)
AGENT_WORKER_ENABLED=true
AGENT_WORKER_POLL_SECONDS=2
AGENT_WORKER_BATCH_SIZE=2
AGENT_DEFAULT_CONTEXT_LIMIT=25
AGENT_MAX_CONTEXT_LIMIT=120
AGENT_MODEL_TIMEOUT_SECONDS=45
AGENT_MODEL_RETRIES=2
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOOL_CALLS=6
AGENT_PRIMARY_PROVIDER=gemini
AGENT_PRIMARY_MODEL=gemini-2.0-flash
AGENT_FALLBACK_ENABLED=true
AGENT_FALLBACK_PROVIDER=openai
AGENT_FALLBACK_MODEL=gpt-4o-mini

# Provider credentials
GEMINI_API_KEY=
OPENAI_API_KEY=

# Frontend runtime endpoints
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000
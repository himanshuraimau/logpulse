# Backend settings
APP_NAME=LogPulse API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api/v1

# Allow comma-separated values for CORS_ORIGINS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local backend connection defaults
DATABASE_URL=postgresql+psycopg://logpulse:logpulse@localhost:5432/logpulse
ENABLE_KAFKA=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_LOGS_RAW=logs.raw
KAFKA_CONSUMER_GROUP=logpulse-stream-local
KAFKA_POLL_TIMEOUT_MS=1000
LOG_BUFFER_SIZE=500
BATCH_INTERVAL_SECONDS=900
BATCH_WINDOW_EVENTS=1200
BATCH_USE_PYSPARK=true
BATCH_RUN_LOOP=false

# Frontend runtime endpoints
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000